# Prefer: elixir scripts/generate_secrets.exs (creates .env and .access-token).
# SHA-256 hex digest of the API token, not the raw token:
RESCUEMASH_API_TOKEN_HASH=
# Base64 of exactly 32 random bytes; share only with trusted nodes:
RESCUEMASH_NODE_SHARED_KEY=
# At least 64 random characters:
SECRET_KEY_BASE=
PHX_HOST=localhost
PORT=4000
MESH_PORT=43690
DISCOVERY_PORT=43691
# DATA_DIR=data
MESH_BROADCAST_ADDRESS=255.255.255.255
